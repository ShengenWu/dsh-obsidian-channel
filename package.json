{
  "name": "dsh-obsidian-channel",
  "version": "0.1.0",
  "description": "DeepSeek Harness (DSH) plugin: native Obsidian vault channel — write-side tools (create/update/append/delete/batch) with approval gate, change journal, and byte-level rollback (undo/rollback/restore).",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./engine": {
      "default": "./src/engine.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "lib/",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "obsidian",
    "vault",
    "rollback",
    "journal",
    "approval"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/cordis": "*",
    "dsh-obsidian-export": "*",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/dsh-sandbox": ">=0.1.0-rc.6 <1"
  },
  "peerDependenciesMeta": {
    "dsh-obsidian-export": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test tests/engine.test.mjs",
    "build": "tsdown --config ./tsdown.config.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "tsdown": "0.22.2"
  }
}
