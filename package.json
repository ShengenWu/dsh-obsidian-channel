{
  "name": "dsh-obsidian-channel",
  "version": "0.1.1-rc.1",
  "description": "Let a DSH agent read and write your local Obsidian vault, with approval and one-click rollback.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./engine": {
      "default": "./src/engine.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "lib/",
    "presets/",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "SKILL.md",
    "docs/"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "obsidian",
    "vault",
    "rollback",
    "journal",
    "approval"
  ],
  "license": "MIT",
  "author": "ShengenWu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShengenWu/dsh-obsidian-channel.git"
  },
  "bugs": {
    "url": "https://github.com/ShengenWu/dsh-obsidian-channel/issues"
  },
  "homepage": "https://github.com/ShengenWu/dsh-obsidian-channel#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/schemastery": ">=3.18.0 <5",
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6 <1",
    "@deepseek-ai/dsh-sandbox": ">=0.1.0-rc.6 <1"
  },
  "scripts": {
    "test": "node --test tests/engine.test.mjs tests/prompt.test.mjs tests/preset-sync.test.mjs tests/pick-folder.test.mjs tests/markdown.test.mjs tests/home-layout.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "build": "tsdown --config ./tsdown.config.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "tsdown": "0.22.2"
  }
}
